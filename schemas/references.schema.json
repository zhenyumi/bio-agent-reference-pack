{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bio-agent-reference-pack/references.schema.json",
  "title": "references.yaml schema",
  "type": "object",
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "source_type",
          "upstream",
          "license",
          "version",
          "acquisition_mode",
          "local_path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "status": { "enum": ["planned", "candidate", "reviewed", "acquired", "deprecated"] },
          "source_type": { "type": "string" },
          "upstream": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "license_evidence_url": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "acquisition_mode": {
            "enum": [
              "git_submodule",
              "pinned_vendor_snapshot",
              "link_only",
              "metadata_only",
              "defer",
              "do_not_include"
            ]
          },
          "local_path": { "type": ["string", "null"] },
          "reading_priority": {
            "enum": ["must_read", "optional_read", "project_specific_read"]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
